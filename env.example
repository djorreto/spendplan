# ========================================
# SUPABASE CONFIGURATION (Requerido)
# ========================================
# Obtén estos valores de tu proyecto en https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
SUPABASE_URL=https://tu-proyecto.supabase.co

# ========================================
# APP CONFIGURATION
# ========================================
NEXT_PUBLIC_APP_URL=https://tu-app.vercel.app
NEXT_PUBLIC_APP_NAME="SpendPlan"

# ========================================
# PRIVATE BETA (Allowlist)
# ========================================
# Si está en true, solo emails presentes en la tabla `beta_allowlist`
# podrán registrarse y usar la app.
BETA_MODE=true

# ========================================
# AI CONFIGURATION - GROQ (Gratis)
# ========================================
# Obtén tu API key gratis en https://console.groq.com
GROQ_API_KEY=gsk_tu-api-key-de-groq

# ========================================
# TELEGRAM BOT (Opcional)
# ========================================
# Crea tu bot con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=tu-token-de-telegram
